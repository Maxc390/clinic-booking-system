# ==================================================
# Django Core
# ==================================================
SECRET_KEY=your-very-secret-key-change-in-production-min-50-chars

DEBUG=True

ALLOWED_HOSTS=localhost,127.0.0.1

# ==================================================
# Database — Neon PostgreSQL
# ==================================================
# Get this from: https://console.neon.tech → your project → Connection Details
# Use the POOLED connection string (ends with ?sslmode=require)
DATABASE_URL=postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# ==================================================
# Django Settings Module
# ==================================================
DJANGO_SETTINGS_MODULE=config.settings.development

# ==================================================
# Azure App Service (only needed in production)
# ==================================================
# AZURE_WEBAPP_NAME=clinic-booking-app
# WEBSITE_HOSTNAME=clinic-booking-app.azurewebsites.net

# ==================================================
# Email (optional — for future notifications)
# ==================================================
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=your@email.com
# EMAIL_HOST_PASSWORD=your-app-password
